{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://distortedlogic.net/schemas/review.schema.json",
	"title": "Pi review policy",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "items"],
	"properties": {
		"version": {
			"const": 1
		},
		"items": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "title", "files", "prompt"],
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"title": {
						"type": "string",
						"minLength": 1
					},
					"files": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"prompt": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		}
	}
}
