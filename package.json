{
	"name": "pi-sync",
	"version": "0.1.0",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-sync.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"format": "biome check --write .",
		"lint": "biome check .",
		"pack:check": "npm pack --dry-run",
		"prepublishOnly": "npm run release:check",
		"release:check": "npm run check && npm audit --omit=dev && npm run pack:check",
		"test": "npm run test:unit && npm run test:integration",
		"test:integration": "node --import tsx --test test/smoke.test.ts",
		"test:unit": "node --import tsx --test test/commands.test.ts test/conflicts.test.ts test/coordinator.test.ts test/files.test.ts test/git.test.ts test/package-execution.test.ts test/plan.test.ts test/recovery.test.ts test/security.test.ts test/settings.test.ts test/state.test.ts test/transaction.test.ts test/ui.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md",
		"RELEASE.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"@secretlint/config-loader": "11.2.4",
		"@secretlint/core": "11.2.4",
		"@secretlint/secretlint-rule-preset-recommend": "11.2.4",
		"fast-json-patch": "3.1.1",
		"json-stable-stringify": "1.3.0",
		"jsonc-parser": "3.3.1",
		"minimatch": "10.2.5",
		"npm-package-arg": "12.0.2",
		"proper-lockfile": "4.1.2",
		"secretlint": "11.2.4",
		"semver": "7.8.0",
		"write-file-atomic": "8.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "22.20.4",
		"@types/npm-package-arg": "6.1.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"@types/write-file-atomic": "4.0.3",
		"tsx": "4.23.15",
		"typebox": "1.3.34",
		"typescript": "7.0.2"
	}
}
