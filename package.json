{
  "name": "pi-config-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Synchronize Pi configuration between THIS MACHINE and a SHARED REPOSITORY.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "11.2.4",
    "secretlint": "11.2.4",
    "diff": "8.0.4",
    "json-stable-stringify": "1.3.0",
    "minimatch": "10.2.5",
    "proper-lockfile": "4.1.2",
    "write-file-atomic": "8.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
