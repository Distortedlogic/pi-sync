{
  "name": "pi-config-sync",
  "version": "0.1.0",
  "description": "Synchronize Pi configuration between THIS MACHINE and a SHARED REPOSITORY.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "biome check .",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run check && npm audit --omit=dev && npm run pack:check",
    "test": "vitest run",
    "test:e2e": "vitest run test/two-machine.test.ts --no-file-parallelism",
    "test:unit": "vitest run --exclude test/two-machine.test.ts",
    "typecheck": "tsc"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "RELEASE.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@secretlint/node": "11.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "11.2.4",
    "fast-json-patch": "3.1.1",
    "json-stable-stringify": "1.3.0",
    "jsonc-parser": "3.3.1",
    "minimatch": "10.2.5",
    "npm-package-arg": "12.0.2",
    "proper-lockfile": "4.1.2",
    "secretlint": "11.2.4",
    "semver": "7.8.0",
    "write-file-atomic": "8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.19",
    "@types/npm-package-arg": "6.1.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.7.1",
    "@types/write-file-atomic": "4.0.3",
    "fast-check": "4.3.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
